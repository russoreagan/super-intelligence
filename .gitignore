# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Environment
.env
.env.*
!.env.example

# Supabase CLI local link/temp state
supabase/.temp/

# LanceDB (binary vector store — large, session-specific)
second_brain/episodes/
second_brain/archive/

# Langfuse / observability local data (top-level only — brain/observability/ is source code)
/observability/

# Per-session wiring snapshots are large + redundant with the current wiring.json
second_brain/wiring_history/

# Claude Code local config
.claude/

# macOS
.DS_Store

# Runtime state — regenerated at boot / mutated every turn; not source.
# (schema/*.md is the editable identity seed and stays tracked.)
second_brain/jobs/
second_brain/wiring.json
second_brain/dmn_novelty.json
second_brain/task_queue.json
second_brain/deferred_thoughts.md

# Per-persona brains: same runtime classes as above, just namespaced under a
# persona slug. schema/*.md (the seeded persona identity) stays tracked; binary
# LanceDB stores + per-turn mutable state are ignored.
second_brain/personas/*/episodes/
second_brain/personas/*/wiring.json
second_brain/personas/*/wiring_history/
second_brain/personas/*/dmn_novelty.json
second_brain/personas/*/task_queue.json
second_brain/personas/*/deferred_thoughts.md
second_brain/personas/*/jobs/

# Process logs + service heartbeats — pure runtime output.
*.log
second_brain/cloud_usage.json
second_brain/runpod_heartbeat.json

# Per-user tenant data (multi-tenant provisioner runtime)
tenants/

# Paper manuscripts (generated/working docs — not versioned)
/PAPER*.md
/PAPER*.html
