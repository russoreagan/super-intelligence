# ──────────────────────────────────────────────────────────────────────────────
# Cloud LLM providers
# ──────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Supabase (required when BRAIN_STORAGE_BACKEND=supabase)
# Service key is server-side only — never expose to browser.
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# UI AUTH (Supabase GoTrue). The whole UI is gated behind sign-in — nothing,
# including the landing page, is public. Accounts are invite-only: provision
# them with `python -m scripts.create_user` (no public sign-up exists).
#   • SUPABASE_JWT_SECRET (optional): the project's legacy JWT secret
#     (Dashboard → Project Settings → API → JWT Secret). When set, access tokens
#     are verified locally/offline (fast). When unset, each request is validated
#     against GoTrue's /user endpoint (one extra network hop — still correct).
#   • BRAIN_AUTH_DISABLED=true bypasses the gate for LOCAL DEV ONLY. Never set
#     this in production — it makes the entire app public.
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=
BRAIN_AUTH_DISABLED=

# Storage backend: "local" (default, file-based) or "supabase" (cloud, multi-tenant)
BRAIN_STORAGE_BACKEND=local

# Multi-tenant: session keep-alive after last client disconnects (seconds)
BRAIN_SESSION_IDLE_TIMEOUT_S=600

# ──────────────────────────────────────────────────────────────────────────────
# Local LLM / embeddings (Ollama)
# Required for offline embedding fast-path. Pull nomic-embed-text first:
#   ollama pull nomic-embed-text
# ──────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
GOOGLE_EMBED_MODEL=text-embedding-004

# ──────────────────────────────────────────────────────────────────────────────
# RunPod GPU pod (hosted inference) — set in the deploy env (e.g. Railway), not
# needed for local dev. The gateway owns ONE shared pod, demand-driven: it runs
# only while a brain needs it and is paused otherwise. Tenants are consumers.
#   RUNPOD_API_KEY   — enables pod lifecycle. Unset → cloud-only (no GPU pod).
#   RUNPOD_MODEL     — generation model pulled onto the pod (default qwen2.5:32b).
#   RUNPOD_HOST      — usually left empty; the gateway discovers + publishes it.
# ──────────────────────────────────────────────────────────────────────────────
RUNPOD_API_KEY=
# Generation model pulled onto the pod. The GPU selector picks the smallest/cheapest
# card that can actually RUN this model on the GPU (a 32B needs a ~40GB+ card like the
# A40/A6000 — ~$0.33-0.35/hr, under the ceiling; it will NOT deploy a 32B onto a 24GB
# card, where it spills to CPU and fails). Drop to qwen2.5:14b to run on the cheaper,
# more-available 24GB cards at lower reasoning quality.
RUNPOD_MODEL=qwen2.5:32b
# Override the model-aware GPU VRAM floor (GB). Empty = derived from RUNPOD_MODEL
# (params·1.25: 32b→40, 14b→18, 7b→12). Set only to force a specific minimum.
RUNPOD_MIN_VRAM_GB=
# When the right-sized GPU is out of stock, the manager does NOT cool down — it keeps
# searching every reconcile tick (preferring a good fit over a fast suboptimal pod),
# staying on cloud meanwhile. The cooldown below applies ONLY when a pod came up but
# failed health (churn guard), to avoid a create→terminate loop. Seconds; default 1800.
RUNPOD_UNHEALTHY_COOLDOWN_S=

# Persist the ~20GB model across pod create/destroy so a fresh pod starts warm
# (no re-download). Create a RunPod *network volume* in the console (Storage tab,
# size it for the model, e.g. 40GB), then put its id here. The pod mounts it at
# /root/.ollama and is TERMINATED on pause (cheaper than an idle stopped-pod disk —
# the volume, not the pod, holds the models). Empty → ephemeral per-pod disk +
# re-pull each cold start (the original cost-minimal behavior).
# NOTE: network volumes attach ONLY to Secure Cloud, so a volume-backed pod runs on
# SECURE cloud (a bit pricier/hr than the COMMUNITY default). Pick a datacenter with
# good Secure-Cloud GPU supply when you create the volume. If no Secure GPU is under
# the cost ceiling, the manager falls back to a COMMUNITY pod WITHOUT the volume
# (affordable but cold — re-downloads the model) rather than running pod-less.
RUNPOD_NETWORK_VOLUME_ID=
# Datacenter the network volume lives in (e.g. EU-RO-1). Optional — RunPod infers
# it from the volume id. A network volume pins pods to its one datacenter, so under
# GPU scarcity there the pod may not come up (local-routed cells then degrade — there
# is no runpod→cloud fallback). Mitigate by picking a high-supply DC, or run two
# volumes in two DCs.
RUNPOD_DATA_CENTER_ID=

# ──────────────────────────────────────────────────────────────────────────────
# Voice I/O (only required when launching with --voice)
# ──────────────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice ID — overrides the UI's default voice selection.
ELEVENLABS_VOICE_ID=

# ElevenLabs model. Options:
#   eleven_flash_v2_5    (default) — ~75ms latency, cheapest. Flash has no
#                        audio-tag support, so [mood:X] markup drives
#                        per-chunk stability/style/speed instead.
#   eleven_v3_conversational — realtime v3 (~280ms) over the Text to
#                        Dialogue WebSocket: continuous prosody, inline audio
#                        tags ([gently], [sighs]...), same per-char price as
#                        Flash. Kill switch: BRAIN_TTS_DIALOGUE_WS=0.
#                        Professional Voice Clones degrade on all v3 models.
#   eleven_v3            — same expressiveness, per-chunk HTTP (no WS);
#                        better for pre-rendered content.
#   eleven_multilingual_v2 — previous-gen, good for non-English voices.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# TTS playback device. Options:
#   ""        — system default (correct for local setups with headphones/speakers)
#   "browser" — stream PCM chunks over WebSocket to the browser's Web Audio API.
#               Required when deployed to Railway/cloud. Set this in Railway env.
#   "0"       — device index; run: python -c "import sounddevice as sd; print(sd.query_devices())"
#   "Scarlett" — substring of device name (case-insensitive)
BRAIN_AUDIO_OUTPUT_DEVICE=

# ──────────────────────────────────────────────────────────────────────────────
# Voice input quality — Deepgram tuning + local noise gate
# ──────────────────────────────────────────────────────────────────────────────

# Silence (ms) Deepgram waits before considering a sentence ended. Default 800.
# Lower values cut sentences mid-pause; higher values wait longer to dispatch.
BRAIN_STT_ENDPOINTING_MS=800

# Additional grace period before Deepgram emits UtteranceEnd. Default 1500.
BRAIN_STT_UTTERANCE_END_MS=1500

# Language hint passed to Deepgram. Without this, auto-detection sometimes
# misreads accented speech as a different language.
BRAIN_STT_LANGUAGE=en

# Comma-separated keyword:boost pairs to bias Deepgram toward expected
# vocabulary. Boost is 1–10; higher = more aggressive bias. Add product /
# people / project names you reference often.
BRAIN_STT_KEYWORDS=claude:5,ableton:5,imessage:3,github:3

# Noise gate threshold (RMS over int16 PCM). Chunks below this are replaced
# with silence before they reach Deepgram. Typical values:
#   0     → disabled
#   ~50   → quiet room
#   120   → default; OK for most desktop mics
#   300+  → noisy room with HVAC / chatter
# If Deepgram is missing your speech, try lowering. If it's transcribing
# background noise as fragmented utterances, try raising.
BRAIN_NOISE_GATE_RMS=120

# Barge-in is keyword-driven by default — say one of these words while TTS
# is playing to interrupt and start a new turn. While the brain is speaking,
# any utterance that does NOT contain one of these words is treated as mic
# bleed-through and dropped. Comma-separated, case-insensitive substrings.
BRAIN_BARGE_IN_WORDS=stop,wait,shut up,hold on,pause,enough,never mind,hey brain,brain stop

# Small extra safety net: ignore interrupt() calls in the first N seconds
# of TTS playback. With keyword-driven barge-in this rarely matters, but
# protects against an immediate stray keyword match. Set to 0 to disable.
BRAIN_BARGE_IN_GRACE_SECONDS=0.5

# ──────────────────────────────────────────────────────────────────────────────
# Observability (optional; the local decisions log + eval/turns.jsonl works
# without Langfuse). Cloud Langfuse at https://cloud.langfuse.com or self-host.
# ──────────────────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ──────────────────────────────────────────────────────────────────────────────
# Runtime config
# ──────────────────────────────────────────────────────────────────────────────
BRAIN_MAX_LLM_CALLS_PER_TURN=60
BRAIN_TURN_TIMEOUT_SECONDS=30
BRAIN_LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# Feature flags — equivalent to CLI flags on `python -m brain.run`.
# These are the PRODUCTION defaults — the full stack should always run.
# start.sh reads these; they also take effect when running brain.run directly.
# Only set a flag to false to deliberately disable that subsystem.
# ──────────────────────────────────────────────────────────────────────────────
BRAIN_UI=true               # browser UI at http://localhost:8765
BRAIN_VOICE_MODE=true       # Deepgram STT + ElevenLabs TTS
BRAIN_EARS=false            # Auditory cortex: speaker enrollment, prosody, song fingerprint (optional)
BRAIN_DMN=true              # Default Mode Network — idle thinking every 15s
BRAIN_METACOGNITION=true    # Self-monitoring cell — reflects on behaviour every 30s
BRAIN_MOTOR=true            # Motor cortex — tool use (file I/O, shell commands)

# Motor cortex sandbox. Colon-separated absolute paths the brain may read/write.
# Required when BRAIN_MOTOR=true; filesystem ops are blocked otherwise.
# Set this to the project root (and any other dirs you want accessible).
# Example: BRAIN_MOTOR_PATHS=/Users/yourname/Documents/super intelligence app
BRAIN_MOTOR_PATHS=

# Optional colon-separated allowlist of shell commands the motor cortex may run.
# Empty → use the built-in default safe set.
BRAIN_MOTOR_COMMANDS=

# ──────────────────────────────────────────────────────────────────────────────
# Hebbian + predict-and-surprise (new in this iteration)
# ──────────────────────────────────────────────────────────────────────────────

# Where the Hebbian edge-weight graph lives. Defaults to second_brain/wiring.json.
BRAIN_WIRING_PATH=

# Where per-session wiring snapshots accumulate (for evolution charts).
# Defaults to second_brain/wiring_history/.
BRAIN_WIRING_HISTORY_DIR=

# Disable weighted routing entirely (drafter selection, switch order, recall
# fan-out fall back to uniform). Hebbian learning still runs at sleep
# consolidation — this only freezes *consumption*. Use as an escape hatch
# if behaviour drifts strangely.
BRAIN_WIRING_FROZEN=false

# Force every integrator to wake regardless of predictor confidence. Useful
# for A/B-style eval comparisons against a no-gating baseline. The eval
# harness at `python -m eval.compare` reads this for bucketing.
BRAIN_DISABLE_PREDICT_GATING=false

# ──────────────────────────────────────────────────────────────────────────────
# Eval / decisions log
# ──────────────────────────────────────────────────────────────────────────────

# Path to the append-only JSONL stream. Three record types:
#   {"type": "turn",       ...}   per-turn TurnTrace
#   {"type": "decision",   ...}   predict-and-surprise + Hebbian decisions
#   {"type": "eval_patch", ...}   async patches from baseline/scorer
# Defaults to eval/turns.jsonl.
BRAIN_EVAL_LOG=

# ──────────────────────────────────────────────────────────────────────────────
# Egress / privacy
# ──────────────────────────────────────────────────────────────────────────────
# Controls what happens to PII/personal data before it reaches cloud LLMs.
# Default is "pseudonymize" — PII is replaced with stable ⟨type_n⟩ tokens that
# are swapped back in the cloud response (reversible within a session).
# Modes:
#   pseudonymize  — replace PII with ⟨person_1⟩-style tokens, restore on response (default)
#   redact        — irreversible [REDACTED] (no restore; simpler, less useful to the model)
#   block         — no memory context crosses to cloud at all
#   off           — passthrough (dev/testing only — do not use in production)
BRAIN_EGRESS_MODE=pseudonymize

# ──────────────────────────────────────────────────────────────────────────────
# Cloud-action MCP connectors (CMA executor)
# ──────────────────────────────────────────────────────────────────────────────
# The brain is domain-agnostic: vertical capabilities (trading, scheduling, …)
# live behind remote MCP servers the motor cortex calls as "connectors", never as
# native in-tree tools. Connectors load in priority order:
#   1. BRAIN_CMA_MCP_SERVERS (this JSON)   — env-pinned, registry becomes read-only
#   2. Supabase mcp_connectors (org-scoped) — the hosted source of truth
#   3. cma_mcp.json (local file fallback)
#
# BRAIN_CMA_MCP_SERVERS — JSON array of {"name","url"}. Per-connector bearer token
# comes from BRAIN_CMA_MCP_<NAME>_TOKEN, where <NAME> is the connector name
# upper-cased with '-' → '_'. Env-pinned connectors use that token as a STATIC
# bearer (no per-end-user HMAC) — set it to the secret the MCP server expects.
BRAIN_CMA_MCP_SERVERS=

# ── Trading connector (replaces the retired native trading layer) ──────────────
# Register the trading app's read-only/advise-only MCP server as connector
# "trading", then bind it to the trading mandate so ONLY the trading agent sees
# its tools (set the agent's permissions.motor_user_connectors and
# .motor_self_connectors to "trading" — see brain/clusters/trading/README.md).
#   BRAIN_CMA_MCP_SERVERS=[{"name":"trading","url":"https://exquisite-courtesy-production-e579.up.railway.app/api/mcp/trading"}]
# The token below MUST equal the trading app's TRADING_MCP_SECRET (same value set
# on both services).
BRAIN_CMA_MCP_TRADING_TOKEN=

# Native trading layer kill-switch (brain/clusters/trading/*). The package stays
# in-tree but is OFF by default (settings trading_enabled=0). This env var
# overrides a stale per-tenant settings.json without editing it:
#   0 / false / off / no → force native layer OFF (use the MCP connector instead)
#   any other value      → force native layer ON
#   unset                → fall back to the trading_enabled setting (default 0)
BRAIN_NATIVE_TRADING=0
